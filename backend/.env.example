API_PORT=4000
API_HOST=0.0.0.0
# Python LangGraph SMS parser service, reachable from this API.
SMS_SERVICE_URL=http://127.0.0.1:8000
# Generate a private secret with: openssl rand -hex 32
JWT_SECRET=replace-with-a-private-random-secret

# Email verification and password recovery (Resend)
AUTH_PUBLIC_URL=https://api.example.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=FinSight <no-reply@example.com>

# Supabase (required for API storage)
SUPABASE_URL=
# Server-only secret key; never ship it in the React Native app.
SUPABASE_SECRET_KEY=

# Investment brokers
GROWW_API_KEY=          # you have this — live holdings sync unlocks when set
KITE_API_KEY=           # not issued yet — Kite stays an option-only tile
ANGELONE_API_KEY=       # option-only tile

# Card feeds (option-only until statement APIs are provisioned)
MASTERCARD_API_KEY=
VISA_API_KEY=
AMEX_API_KEY=
